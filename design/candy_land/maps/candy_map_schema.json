{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/candy-map.schema.json",
  "title": "Candy Map Generator Specification",
  "type": "object",
  "required": [
    "schema_version",
    "map_id",
    "display_name",
    "difficulty_index",
    "png_reference",
    "godot_import",
    "match_rules",
    "edible_tiers",
    "regions",
    "pathways",
    "blockers",
    "spawn_rules",
    "bot_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "map_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "difficulty_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "difficulty_label": {
      "type": "string"
    },
    "title_text": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "png_reference": {
      "type": "object"
    },
    "godot_import": {
      "type": "object"
    },
    "match_rules": {
      "type": "object"
    },
    "edible_tiers": {
      "type": "array"
    },
    "regions": {
      "type": "array"
    },
    "pathways": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "spawn_rules": {
      "type": "object"
    },
    "hazards": {
      "type": "array"
    },
    "bot_rules": {
      "type": "object"
    },
    "audio_visual_hints": {
      "type": "object"
    },
    "generator_notes": {
      "type": "array"
    }
  },
  "additionalProperties": true
}